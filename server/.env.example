# ReGen Server Environment Template (NEVER put real secrets in .env.example)
PORT=5006
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/regen
JWT_SECRET=replace-with-strong-random-secret
FRONTEND_BASE_URL=https://regen.krishub.in
AUTH_DATABASE_URL=postgres://user:password@127.0.0.1:5432/auth_service
SUPER_ADMIN_USERNAME=Vyshwa

# Firebase Cloud Messaging (HTTP v1 Admin Credential)
# Production: store JSON outside Git repo (e.g. /etc/regen/secrets/firebase-service-account.json)
# Local Dev: either set FIREBASE_SERVICE_ACCOUNT_PATH or place untracked server/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/regen/secrets/firebase-service-account.json
